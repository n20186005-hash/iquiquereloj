---
import { getI18n } from '../i18n/ui';
const { lang, messages } = getI18n(Astro.url);
const f = messages.footer;
---
<footer class="section-padding" style="background: var(--bg-tertiary); border-top: 1px solid var(--border-color);">
  <div class="max-w-6xl mx-auto px-4 space-y-5 text-sm" style="color: var(--text-secondary);">
    <p>{f.rights}</p>
    <p set:html={f.disclaimer}></p>
    <p>{f.imageCopyright}</p>
    <nav class="flex flex-wrap gap-5" aria-label={f.legalLinksTitle}>
      <a href={`/${lang}/privacy-policy/`}>{f.privacy}</a>
      <a href={`/${lang}/terms-of-service/`}>{f.terms}</a>
      <a href={`/${lang}/cookie-settings/`}>{f.cookies}</a>
    </nav>
  </div>
</footer>
